# ============================================================
#  ENVIRONMENT VARIABLES TEMPLATE (safe to commit — NO production secrets)
#  Copy this file to ".env" and fill in your own secrets.
# ============================================================

# --- Postgres (npm run db:local; local container credentials only) ---
# The app itself connects through Hyperdrive's `localConnectionString` in
# wrangler.jsonc, so it needs nothing here.
# db:local reads this to start Docker; drizzle-kit uses it as the schema owner.
# Never read by the Worker. Keep TEST_DATABASE_URL on the same owner credentials.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54363/postgres"
# Vitest creates isolated databases from a migrated template.
TEST_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54363/postgres"

# --- TMDB API ---
# TMDB v4 "API Read Access Token" (Bearer). Get it at:
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=""

# --- Google Sign-In (OAuth 2.0) ---
# Create an "OAuth client ID" of type "Web application" at:
# https://console.cloud.google.com/apis/credentials
# Register these Authorized redirect URIs (one per environment you use):
#   http://localhost:5173/auth/google/callback
#   https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. The public origin used to build the OAuth redirect URI. Leave empty
# to derive it from the incoming request, which is correct almost everywhere;
# set it only if a proxy rewrites the Host header.
# OAUTH_ORIGIN="https://watchlater.example.com"

# --- One-time cutover only (never needed by the Worker) ---
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
# TARGET_DATABASE_URL=""
